<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_6dof_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch files and pick-and-place nodes for 6-DOF robot arm stack</description>
  <maintainer email="josiah@todo.todo">josiah</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>my_6dof_description</exec_depend>
  <exec_depend>my_6dof_controllers</exec_depend>
  <exec_depend>my_6dof_gazebo</exec_depend>
  <exec_depend>my_6dof_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
